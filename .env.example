# Copy to .env.local and configure locally. No credential values belong in Git.
# Browser-visible Mapbox public token (pk.) only; use minimum scope and URL restrictions.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Keep the legacy browser LLM variable empty. Never put an OpenAI secret here.
# The current chat needs a separate server-side migration before using a new key.
NEXT_PUBLIC_OPENAI_API_KEY=

# Reserved for that future server-only migration; not wired into the current prototype.
OPENAI_API_KEY=
