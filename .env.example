# Copy to .env.local and fill in locally. Never commit real values.

# --- LLM (server only; never prefix with NEXT_PUBLIC_) ---
# Leave empty to run the built-in demo responder (no API cost).
OPENAI_API_KEY=
# Any Responses-API model. Small models keep cost low.
OPENAI_MODEL=gpt-5-mini
# 1 = let the model use OpenAI's web_search tool for fresher info (costs more per turn).
OPENAI_WEB_SEARCH=0
# Upper bound for one reply.
OPENAI_MAX_OUTPUT_TOKENS=2500

# --- Cost / abuse guards ---
# If set, the app asks for this code once and sends it with every API call.
APP_ACCESS_CODE=
# Chat turns per client IP per hour, and for the whole server per day.
CHAT_LIMIT_PER_HOUR=40
CHAT_LIMIT_PER_DAY=400

# --- Optional live sync between two devices (Upstash Redis REST) ---
# Without these, sync uses in-memory storage (works for `npm run dev` / a single `npm start`).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Geo services (OpenStreetMap based, no key) ---
# Contact string sent in the User-Agent, as the Nominatim/Photon usage policy asks.
GEO_CONTACT=covoyager-travel-chat (github.com/moruku36/covoyager-travel-chat)
